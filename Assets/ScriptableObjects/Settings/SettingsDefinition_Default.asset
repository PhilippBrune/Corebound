%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a646d8c49efdbf34bb8a973e875b93ac, type: 3}
  m_Name: SettingsDefinition_Default
  m_EditorClassIdentifier: 
  _categories:
  - _categoryType: 0
    _label: Audio
    _options:
    - _key: 0
      _label: Music Volume
      _description: Adjust the music layer for the Main Menu and future Runs.
      _optionKind: 0
      _minValue: 0
      _maxValue: 1
      _stepValue: 0.1
      _defaultFloatValue: 0.8
      _defaultToggleValue: 0
      _defaultChoiceIndex: 0
      _choiceLabels: []
    - _key: 1
      _label: SFX Volume
      _description: Controls moment-to-moment combat and menu feedback loudness.
      _optionKind: 0
      _minValue: 0
      _maxValue: 1
      _stepValue: 0.1
      _defaultFloatValue: 0.85
      _defaultToggleValue: 0
      _defaultChoiceIndex: 0
      _choiceLabels: []
    - _key: 2
      _label: UI Volume
      _description: Controls button focus, confirm and cancel feedback volume.
      _optionKind: 0
      _minValue: 0
      _maxValue: 1
      _stepValue: 0.1
      _defaultFloatValue: 0.9
      _defaultToggleValue: 0
      _defaultChoiceIndex: 0
      _choiceLabels: []
  - _categoryType: 1
    _label: Graphics
    _options:
    - _key: 3
      _label: Quality Preset
      _description: Switches between a lean, balanced or richer presentation preset.
      _optionKind: 2
      _minValue: 0
      _maxValue: 0
      _stepValue: 1
      _defaultFloatValue: 0
      _defaultToggleValue: 0
      _defaultChoiceIndex: 1
      _choiceLabels:
      - Low
      - Medium
      - High
    - _key: 4
      _label: Resolution Preset
      _description: Chooses a controller-safe window resolution preset.
      _optionKind: 2
      _minValue: 0
      _maxValue: 0
      _stepValue: 1
      _defaultFloatValue: 0
      _defaultToggleValue: 0
      _defaultChoiceIndex: 2
      _choiceLabels:
      - 1280x720
      - 1600x900
      - 1920x1080
    - _key: 5
      _label: Display Mode
      _description: Windowed has a title bar; Frameless Window has none and sits centred at the chosen resolution; the two fullscreen modes cover the whole display.
      _optionKind: 2
      _minValue: 0
      _maxValue: 0
      _stepValue: 1
      _defaultFloatValue: 0
      _defaultToggleValue: 0
      _defaultChoiceIndex: 1
      _choiceLabels:
      - Windowed
      - Borderless Fullscreen
      - Exclusive Fullscreen
      - Frameless Window
    - _key: 6
      _label: VSync
      _description: Locks presentation to the display refresh for steadier pacing.
      _optionKind: 1
      _minValue: 0
      _maxValue: 0
      _stepValue: 1
      _defaultFloatValue: 0
      _defaultToggleValue: 1
      _defaultChoiceIndex: 0
      _choiceLabels: []
  - _categoryType: 2
    _label: Accessibility
    _options:
    - _key: 7
      _label: Screen Shake Intensity
      _description: Reduces camera shake without removing hit readability.
      _optionKind: 0
      _minValue: 0
      _maxValue: 1
      _stepValue: 0.1
      _defaultFloatValue: 0.5
      _defaultToggleValue: 0
      _defaultChoiceIndex: 0
      _choiceLabels: []
    - _key: 8
      _label: Effects Intensity
      _description: Controls the density of combat and UI effect presentation.
      _optionKind: 0
      _minValue: 0
      _maxValue: 1
      _stepValue: 0.1
      _defaultFloatValue: 0.75
      _defaultToggleValue: 0
      _defaultChoiceIndex: 0
      _choiceLabels: []
    - _key: 9
      _label: HUD Scale
      _description: Enlarges or tightens HUD presentation for readability.
      _optionKind: 0
      _minValue: 0.8
      _maxValue: 1.4
      _stepValue: 0.1
      _defaultFloatValue: 1
      _defaultToggleValue: 0
      _defaultChoiceIndex: 0
      _choiceLabels: []
    - _key: 14
      _label: Show Run Timer
      _description: Shows the run clock and level progress on the HUD. Off by default.
      _optionKind: 1
      _minValue: 0
      _maxValue: 1
      _stepValue: 1
      _defaultFloatValue: 0
      _defaultToggleValue: 0
      _defaultChoiceIndex: 0
      _choiceLabels: []
    - _key: 15
      _label: Core Alerts
      _description: Threat lines to the Core, a marker when it is off-screen, and a screen-edge pulse when it is hit.
      _optionKind: 1
      _minValue: 0
      _maxValue: 1
      _stepValue: 1
      _defaultFloatValue: 0
      _defaultToggleValue: 1
      _defaultChoiceIndex: 0
      _choiceLabels: []
    - _key: 12
      _label: Language
      _description: Switches all in-game text between English and German.
      _optionKind: 2
      _minValue: 0
      _maxValue: 0
      _stepValue: 1
      _defaultFloatValue: 0
      _defaultToggleValue: 0
      _defaultChoiceIndex: 0
      _choiceLabels:
      - English
      - Deutsch
  - _categoryType: 3
    _label: Controls
    _options:
    - _key: 13
      _label: Input Device
      _description: Automatic follows whichever device you last used; Controller and Mouse fix it.
      _optionKind: 2
      _minValue: 0
      _maxValue: 0
      _stepValue: 1
      _defaultFloatValue: 0
      _defaultToggleValue: 0
      _defaultChoiceIndex: 0
      _choiceLabels:
      - Automatic
      - Controller
      - Mouse and Keyboard
    - _key: 10
      _label: Controller Aim Assist Strength
      _description: Adjusts the global controller soft-aim contribution for Weapons.
      _optionKind: 0
      _minValue: 0
      _maxValue: 1
      _stepValue: 0.1
      _defaultFloatValue: 0.65
      _defaultToggleValue: 0
      _defaultChoiceIndex: 0
      _choiceLabels: []
    - _key: 11
      _label: Control Profile
      _description: Applies a predefined rebind profile to the current Input Actions.
      _optionKind: 2
      _minValue: 0
      _maxValue: 0
      _stepValue: 1
      _defaultFloatValue: 0
      _defaultToggleValue: 0
      _defaultChoiceIndex: 0
      _choiceLabels:
      - Default
      - Shoulder Fire
      - Swap Confirm/Cancel
      - Southpaw
